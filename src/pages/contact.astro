---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact Us - Bijli Gyaan | Er. Pramod Kumar"
  description="Bijli Gyaan team aur Er. Pramod Kumar se contact karein. House wiring, electrical safety, load calculation aur rooftop solar consultation ke liye."
>
  <main class="max-w-4xl mx-auto px-4 py-10 text-slate-200">
    
    <!-- Header Card -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 md:p-10 shadow-2xl mb-8 relative overflow-hidden">
      <div class="absolute -right-16 -top-16 w-52 h-52 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <span class="text-xs font-bold text-amber-400 uppercase tracking-wider bg-amber-400/10 px-3 py-1 rounded-md border border-amber-400/20">
        Direct Support & Consultation
      </span>
      <h1 class="text-3xl md:text-4xl font-extrabold text-white mt-3">
        Contact <span class="text-amber-400">Bijli Gyaan</span>
      </h1>
      <p class="text-slate-400 text-sm md:text-base mt-2 max-w-2xl leading-relaxed">
        Ghar ki wiring, MCB/RCCB sizing, sanctioned load penalty ya rooftop solar PM Surya Ghar Yojana se judi kisi bhi query ke liye aap humse seedha sampark kar sakte hain.
      </p>

      <!-- Direct Contact Badges -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6 pt-6 border-t border-slate-800">
        <div class="flex items-center gap-3 p-3 bg-slate-800/40 rounded-xl border border-slate-800">
          <div class="w-10 h-10 rounded-lg bg-amber-400/10 border border-amber-400/30 flex items-center justify-center text-amber-400 text-lg font-bold">
            ✉
          </div>
          <div>
            <div class="text-xs text-slate-400">Official Email</div>
            <a href="mailto:officialpramod91@gmail.com" class="text-white hover:text-amber-400 font-semibold text-sm transition-colors">
              officialpramod91@gmail.com
            </a>
          </div>
        </div>

        <div class="flex items-center gap-3 p-3 bg-slate-800/40 rounded-xl border border-slate-800">
          <div class="w-10 h-10 rounded-lg bg-emerald-400/10 border border-emerald-400/30 flex items-center justify-center text-emerald-400 text-lg font-bold">
            ⚡
          </div>
          <div>
            <div class="text-xs text-slate-400">Response Time</div>
            <div class="text-white font-semibold text-sm">Within 24-48 Hours</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact Form Container -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 md:p-10 shadow-xl">
      <h2 class="text-xl font-bold text-white mb-2">Send Us a Message</h2>
      <p class="text-slate-400 text-xs md:text-sm mb-6">Neeche diye gaye form ko bharein, hum aapse jald se jald connect karenge.</p>

      <!-- Form: Replace action with your Formspree ID or backend API later -->
      <form 
        action="https://formspree.io/f/xyz" 
        method="POST"
        class="space-y-5"
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <!-- Name Field -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1.5">
              Aapka Naam (Name) <span class="text-amber-400">*</span>
            </label>
            <input 
              type="text" 
              name="name" 
              required 
              placeholder="e.g. Ramesh Sharma" 
              class="w-full bg-slate-950 border border-slate-800 focus:border-amber-400 focus:ring-1 focus:ring-amber-400 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-600 outline-none transition-all"
            />
          </div>

          <!-- Email Field -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1.5">
              Email Address <span class="text-amber-400">*</span>
            </label>
            <input 
              type="email" 
              name="email" 
              required 
              placeholder="e.g. ramesh@gmail.com" 
              class="w-full bg-slate-950 border border-slate-800 focus:border-amber-400 focus:ring-1 focus:ring-amber-400 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-600 outline-none transition-all"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <!-- Address / City Field -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1.5">
              Address / City, State <span class="text-amber-400">*</span>
            </label>
            <input 
              type="text" 
              name="address" 
              required 
              placeholder="e.g. Lucknow, Uttar Pradesh" 
              class="w-full bg-slate-950 border border-slate-800 focus:border-amber-400 focus:ring-1 focus:ring-amber-400 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-600 outline-none transition-all"
            />
          </div>

          <!-- Phone Number Field -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1.5">
              Phone Number <span class="text-slate-500 font-normal">(Optional)</span>
            </label>
            <input 
              type="tel" 
              name="phone" 
              placeholder="e.g. 9876543210" 
              class="w-full bg-slate-950 border border-slate-800 focus:border-amber-400 focus:ring-1 focus:ring-amber-400 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-600 outline-none transition-all"
            />
          </div>
        </div>

        <!-- Comments / Message Field -->
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">
            Aapka Sawal ya Suggestion (Comments / Message) <span class="text-amber-400">*</span>
          </label>
          <textarea 
            name="comments" 
            rows="4" 
            required 
            placeholder="Apne load calculation, wiring samasya ya solar inquiry ke baare mein vistar se likhein..."
            class="w-full bg-slate-950 border border-slate-800 focus:border-amber-400 focus:ring-1 focus:ring-amber-400 rounded-xl p-4 text-sm text-white placeholder-slate-600 outline-none transition-all resize-none"
          ></textarea>
        </div>

        <!-- Submit Button -->
        <div>
          <button 
            type="submit" 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 text-slate-950 font-bold px-8 py-3 rounded-xl shadow-lg shadow-amber-500/20 text-sm transition-all transform active:scale-95"
          >
            <span>⚡</span> Message Send Karein
          </button>
        </div>
      </form>
    </div>

  </main>
</Layout>