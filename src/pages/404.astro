---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404: Page Not Found | Bijli Gyaan" description="Aap jo page dhoondh rahe hain wo maujood nahi hai.">
  <div class="min-h-[70vh] flex items-center justify-center px-4 py-16 bg-slate-50">
    <div class="max-w-md w-full text-center bg-white p-8 rounded-2xl border border-slate-200 shadow-sm">
      <div class="w-20 h-20 bg-amber-100 text-amber-600 rounded-full flex items-center justify-center mx-auto mb-6 text-4xl font-black">
        ⚡
      </div>
      <h1 class="text-3xl font-black text-slate-900 mb-2">404 - Circuit Broken!</h1>
      <p class="text-slate-600 mb-6 text-sm leading-relaxed">
        Aap jis page par aana chahte the wo yahan nahi hai ya connection cut ho chuka hai.
      </p>
      <a 
        href="/" 
        class="inline-block w-full py-3 px-6 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold rounded-xl transition-all shadow-sm"
      >
        Home Page Par Jayein →
      </a>
    </div>
  </div>
</Layout>