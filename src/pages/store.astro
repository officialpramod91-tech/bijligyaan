<!-- Client-side Category Filtering Logic -->
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.product-card');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      // Toggle button active classes
      buttons.forEach((b) => {
        b.classList.remove('bg-amber-500', 'text-slate-950');
        b.classList.add('bg-slate-800', 'text-slate-200');
      });
      btn.classList.remove('bg-slate-800', 'text-slate-200');
      btn.classList.add('bg-amber-500', 'text-slate-950');

      const filterValue = btn.getAttribute('data-filter');

      // Filter product cards smoothly
      cards.forEach((card) => {
        const cardCategory = card.getAttribute('data-category');
        if (filterValue === 'all' || filterValue === cardCategory) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>