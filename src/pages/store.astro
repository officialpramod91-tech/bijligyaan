---
import Layout from '../layouts/Layout.astro';
import products from '../data/products.json';

interface Product {
  id: string;
  name: string;
  category: 'tools' | 'switchgear' | 'appliances';
  badge: string;
  rating: string;
  specs: string[];
  verdict: string;
  affiliateUrl: string;
  image: string;
}

const productList: Product[] = products as Product[];
---

<Layout title="Bijli Gyaan Verified Store | IS Standards Tested Electrical Tools">
  <main class="min-h-screen bg-slate-900 text-slate-100 py-10 px-4 sm:px-6 lg:px-8 font-sans">
    <div class="max-w-6xl mx-auto">
      
      <!-- Top Authority Hero Header -->
      <header class="text-center mb-10">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-amber-500/10 border border-amber-400/30 text-amber-300 text-sm font-semibold tracking-wide uppercase mb-4">
          <span>⚡</span> Verified Electrical Standards Hub
        </div>
        <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white mb-4">
          Bijli Gyaan <span class="text-amber-400">Verified Store</span>
        </h1>
        <p class="max-w-3xl mx-auto text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
          Indian electrical market me 50%+ duplicate aur substandard saman milta hai. Yeh equipment list <strong class="text-white">Er. Pramod Kumar</strong> ke 10 saal ke practical field experience aur <span class="text-amber-300 font-medium">IS/BIS safety codes</span> ki jaanch ke baad chuni gayi hai.
        </p>
      </header>

      <!-- Emergency Quick Alert Banner -->
      <aside aria-label="Electrical Emergency Alert" class="mb-10 p-5 sm:p-6 rounded-2xl bg-gradient-to-r from-rose-950/80 via-slate-800 to-slate-800 border border-rose-500/40 flex flex-col sm:flex-row items-center justify-between gap-5 shadow-xl">
        <div class="flex items-center gap-4 text-left">
          <div class="w-14 h-14 rounded-2xl bg-rose-500/20 border border-rose-500/40 flex items-center justify-center text-rose-400 text-3xl shrink-0">
            🚨
          </div>
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-500/20 text-rose-300 text-xs font-bold uppercase tracking-wider mb-1.5">
              Emergency Safety Alert
            </div>
            <h2 class="text-lg sm:text-xl font-bold text-white mb-1">
              Ghar Me Current Lagne Ya Aag Lagne Par Turant Kya Karein?
            </h2>
            <p class="text-sm sm:text-base text-slate-300">
              Electric shock first aid, short circuit aag bujhane ke niyam aur IS 2190 / CEA 2023 safety guide padhein.
            </p>
          </div>
        </div>
        <a 
          href="/articles/electric-shock-and-fire-safety-guide/" 
          class="shrink-0 px-6 py-3 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-bold text-sm sm:text-base transition-all duration-200 shadow-md flex items-center gap-2 active:scale-95">
          Emergency Guide Padhein
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </aside>

      <!-- Category Filter Tabs -->
      <nav aria-label="Category Filters" class="flex flex-wrap justify-center gap-2.5 sm:gap-4 mb-10">
        <button 
          data-filter="all" 
          class="filter-btn active px-5 py-2.5 rounded-xl text-sm sm:text-base font-semibold transition-all duration-200 bg-amber-400 text-slate-950 shadow-md">
          All Tested Equipment
        </button>
        <button 
          data-filter="tools" 
          class="filter-btn px-5 py-2.5 rounded-xl text-sm sm:text-base font-semibold transition-all duration-200 bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white border border-slate-700">
          🧰 Essential Home Tools
        </button>
        <button 
          data-filter="switchgear" 
          class="filter-btn px-5 py-2.5 rounded-xl text-sm sm:text-base font-semibold transition-all duration-200 bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white border border-slate-700">
          ⚡ Switchgear & Protection
        </button>
        <button 
          data-filter="appliances" 
          class="filter-btn px-5 py-2.5 rounded-xl text-sm sm:text-base font-semibold transition-all duration-200 bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white border border-slate-700">
          🏠 Safe Heavy Appliances
        </button>
      </nav>

      <!-- Products Grid -->
      <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {productList.map((item) => (
          <article 
            id={item.id}
            data-category={item.category} 
            class="product-card flex flex-col justify-between bg-slate-800/90 border border-slate-700/80 rounded-2xl overflow-hidden hover:border-amber-400/50 transition-all duration-300 shadow-xl scroll-mt-28 target:border-amber-400 target:ring-2 target:ring-amber-400/50">
            
            <div>
              <!-- Standard Verification Badge -->
              <div class="px-5 pt-5 flex items-center justify-between gap-2">
                <span class="inline-block bg-amber-400/15 text-amber-300 border border-amber-400/30 text-xs sm:text-sm px-3 py-1.5 rounded-md font-bold">
                  {item.badge}
                </span>
                <span class="text-xs sm:text-sm text-slate-300 font-medium">
                  {item.rating}
                </span>
              </div>

              <!-- Product Image Container (Clean White Showcase) -->
              <div class="p-4 mx-5 my-4 flex justify-center items-center h-52 bg-white rounded-xl shadow-inner overflow-hidden">
                <img 
                  src={item.image} 
                  alt={item.name} 
                  loading="lazy" 
                  class="max-h-full max-w-full object-contain transition-transform duration-300 hover:scale-105"
                />
              </div>

              <!-- Product Title -->
              <div class="px-5 pb-3">
                <h3 class="text-lg sm:text-xl font-bold text-white hover:text-amber-400 transition-colors leading-snug">
                  {item.name}
                </h3>
              </div>

              <!-- Technical Specifications -->
              <div class="px-5 pb-4">
                <ul class="text-sm text-slate-300 space-y-2 list-disc list-inside leading-relaxed">
                  {item.specs.map((spec) => (
                    <li>{spec}</li>
                  ))}
                </ul>
              </div>

              <!-- Er. Pramod's Field Note Box -->
              <div class="mx-5 mb-5 p-4 bg-slate-900/90 border-l-4 border-amber-400 rounded-r-xl border border-slate-700/50">
                <p class="text-xs sm:text-sm font-bold text-amber-400 uppercase tracking-wider mb-1.5">
                  👨‍🔧 Er. Pramod's Field Verdict:
                </p>
                <p class="text-sm text-slate-200 leading-relaxed italic">
                  "{item.verdict}"
                </p>
              </div>
            </div>

            <!-- CTA Action Button -->
            <div class="p-5 pt-0">
              <a 
                href={item.affiliateUrl} 
                target="_blank" 
                rel="nofollow sponsored noopener" 
                class="w-full flex items-center justify-center gap-2 bg-gradient-to-r from-amber-400 to-amber-500 hover:from-amber-300 hover:to-amber-400 active:scale-[0.98] text-slate-950 font-bold py-3.5 px-4 rounded-xl text-sm sm:text-base transition-all duration-200 shadow-md">
                Check Genuine Price on Amazon
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>

          </article>
        ))}
      </section>

      <!-- ========================================== -->
      <!-- INDIAN ELECTRICAL STANDARDS & BUYING GUIDE -->
      <!-- ========================================== -->
      <section class="mt-20 border-t border-slate-800 pt-16">
        
        <!-- Guide Header -->
        <div class="text-center max-w-3xl mx-auto mb-14">
          <span class="inline-block px-4 py-1.5 rounded-full bg-amber-400/10 border border-amber-400/30 text-amber-300 text-xs sm:text-sm font-bold tracking-wider uppercase mb-3">
            CEA & BIS Compliance Framework
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-white mb-4">
            Indian Electrical Standards (IS Code) Guide: <span class="text-amber-400">Ghar Ki Suraksha Kyu Zaroori Hai?</span>
          </h2>
          <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
            Market me milne wale substandard aur bina certification wale electrical equipment aag (electrical fire) aur fatal electric shock ka sabse bada kaaran bante hain. Central Electricity Authority (CEA) aur Bureau of Indian Standards (BIS) ke niyam har nagrik ko janna zaroori hai.
          </p>
        </div>

        <!-- 3 Core Engineering Pillars -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
          
          <!-- Pillar 1 -->
          <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-6 sm:p-7 shadow-lg">
            <div class="w-12 h-12 rounded-xl bg-amber-400/10 border border-amber-400/30 flex items-center justify-center text-amber-400 font-bold text-lg mb-4">
              01
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-white mb-3">IS 732: Wiring Code of Practice</h3>
            <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-4">
              Bureau of Indian Standards ka IS 732 residential aur commercial buildings ke electrical wiring installation ka base standard hai.
            </p>
            <ul class="text-sm text-slate-300 space-y-2 list-disc list-inside leading-relaxed">
              <li>Separate conduit routing for power and lighting.</li>
              <li>Color coding ka strict palan (Phase: Red/Yellow/Blue, Neutral: Black, Earth: Green).</li>
              <li>Terminal overheating rokne ke liye sahi lugging aur tight connections.</li>
            </ul>
          </div>

          <!-- Pillar 2 -->
          <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-6 sm:p-7 shadow-lg">
            <div class="w-12 h-12 rounded-xl bg-amber-400/10 border border-amber-400/30 flex items-center justify-center text-amber-400 font-bold text-lg mb-4">
              02
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-white mb-3">IS/IEC 61008-1: Life Protection</h3>
            <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-4">
              MCB sirf short-circuit se taar bachata hai, jabki RCCB (Residual Current Circuit Breaker) insani jaan bachata hai.
            </p>
            <ul class="text-sm text-slate-300 space-y-2 list-disc list-inside leading-relaxed">
              <li><strong class="text-amber-300">30mA Tripping:</strong> Residential bathroom aur general circuits me 30mA mandatory hai.</li>
              <li><strong class="text-white">Trip Timing:</strong> Leakage aane par 30 milliseconds ke andar circuit cut hona chahiye.</li>
              <li>100mA/300mA sirf fire protection ke liye main incomer par lagta hai.</li>
            </ul>
          </div>

          <!-- Pillar 3 -->
          <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-6 sm:p-7 shadow-lg">
            <div class="w-12 h-12 rounded-xl bg-amber-400/10 border border-amber-400/30 flex items-center justify-center text-amber-400 font-bold text-lg mb-4">
              03
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-white mb-3">IS 3043: Earthing Regulations</h3>
            <p class="text-sm sm:text-base text-slate-300 leading-relaxed mb-4">
              Proper Earthing kisi bhi installation ki backbone hoti hai. Bina proper earthing ke koi bhi safety device sahi se trigger nahi hota.
            </p>
            <ul class="text-sm text-slate-300 space-y-2 list-disc list-inside leading-relaxed">
              <li>Earth resistance residential me 5 Ohms se kam hona anivarya hai.</li>
              <li>Appliance body metal enclosure direct earth pit se connected honi chahiye.</li>
              <li>Neutral aur earth loop ko alag rakhna CEA Regulation 42 ke antargat aawashyak hai.</li>
            </ul>
          </div>

        </div>

        <!-- Technical Verification Table -->
        <div class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-5 sm:p-8 mb-16 shadow-lg">
          <h3 class="text-lg sm:text-2xl font-bold text-white mb-2">
            Standard Reference Guide: Equipment vs Required Indian Standard
          </h3>
          <p class="text-sm sm:text-base text-slate-300 mb-6">
            Ghar ke liye koi bhi saman lete waqt packaging par diye gaye BIS License (CM/L number) aur IS Code ko verify karein:
          </p>

          <div class="overflow-x-auto rounded-xl border border-slate-700">
            <table class="w-full text-left text-sm sm:text-base text-slate-200 border-collapse min-w-[650px]">
              <thead>
                <tr class="border-b border-slate-700 bg-slate-900 text-amber-400 font-bold uppercase text-xs sm:text-sm tracking-wider">
                  <th class="py-4 px-4 sm:px-6">Equipment / Item</th>
                  <th class="py-4 px-4 sm:px-6">Applicable Standard</th>
                  <th class="py-4 px-4 sm:px-6">Safety Parameter</th>
                  <th class="py-4 px-4 sm:px-6">Substandard Lene Ka Risk</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-700/70 bg-slate-850 font-sans">
                <tr class="hover:bg-slate-700/40 transition-colors">
                  <td class="py-4 px-4 sm:px-6 font-semibold text-white">Miniature Circuit Breaker (MCB)</td>
                  <td class="py-4 px-4 sm:px-6 font-bold text-amber-300">IS/IEC 60898-1</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-300">10kA Breaking Capacity & C-Curve</td>
                  <td class="py-4 px-4 sm:px-6 text-rose-300 font-medium">Contact weld hona, aag lagne ka khatra</td>
                </tr>
                <tr class="hover:bg-slate-700/40 transition-colors">
                  <td class="py-4 px-4 sm:px-6 font-semibold text-white">Residual Current Breaker (RCCB)</td>
                  <td class="py-4 px-4 sm:px-6 font-bold text-amber-300">IS/IEC 61008-1</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-300">30mA Sensitivity, &lt;30ms cutoff</td>
                  <td class="py-4 px-4 sm:px-6 text-rose-300 font-medium">Trip na hona, fatal electric shock</td>
                </tr>
                <tr class="hover:bg-slate-700/40 transition-colors">
                  <td class="py-4 px-4 sm:px-6 font-semibold text-white">FR / FRLS Copper Wires</td>
                  <td class="py-4 px-4 sm:px-6 font-bold text-amber-300">IS 694</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-300">Class 5 flexible bare copper, 70°C PVC</td>
                  <td class="py-4 px-4 sm:px-6 text-rose-300 font-medium">Wire garam hona, zehrila dhuwan nikalna</td>
                </tr>
                <tr class="hover:bg-slate-700/40 transition-colors">
                  <td class="py-4 px-4 sm:px-6 font-semibold text-white">Storage Water Heaters (Geyser)</td>
                  <td class="py-4 px-4 sm:px-6 font-bold text-amber-300">IS 2082 & BEE 5-Star</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-300">Safety valve, 0.8 MPa pressure test</td>
                  <td class="py-4 px-4 sm:px-6 text-rose-300 font-medium">Tank phatna, pani ke pipe me current aana</td>
                </tr>
                <tr class="hover:bg-slate-700/40 transition-colors">
                  <td class="py-4 px-4 sm:px-6 font-semibold text-white">Insulated Screwdrivers</td>
                  <td class="py-4 px-4 sm:px-6 font-bold text-amber-300">IS 8378 / IEC 60900</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-300">10,000V tested (1,000V safe work)</td>
                  <td class="py-4 px-4 sm:px-6 text-rose-300 font-medium">Insulation fail hona, haath me jhatka lagna</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="text-xs text-slate-400 mt-3 sm:hidden text-center">
            👉 Table ko poora dekhne ke liye ungli se left-right scroll karein.
          </p>
        </div>

        <!-- Why Use This Page -->
        <div class="bg-slate-800/80 border border-amber-400/30 rounded-2xl p-6 sm:p-10 mb-12 shadow-xl">
          <div class="flex flex-col md:flex-row gap-6 items-start">
            <div class="w-14 h-14 rounded-2xl bg-amber-500/15 border border-amber-400/40 shrink-0 flex items-center justify-center text-3xl">
              🛡️
            </div>
            <div class="w-full">
              <h3 class="text-xl sm:text-2xl font-bold text-white mb-3">
                Bijli Gyaan Verified Hub Use Karne Ka Fayda Kya Hai?
              </h3>
              <p class="text-base sm:text-lg text-slate-300 leading-relaxed mb-6 font-normal">
                Internet par hazaron affiliate websites sirf product ke features copy-paste karke buy link chipka deti hain. Bijli Gyaan isse alag kyu hai?
              </p>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 text-sm sm:text-base text-slate-200 leading-relaxed">
                <div class="flex items-start gap-3 bg-slate-900/80 p-4 rounded-xl border border-slate-700/60">
                  <span class="text-amber-400 font-black text-lg">✓</span>
                  <span><strong class="text-white font-semibold">Field-Tested Only:</strong> Koi bhi sponsored promotion nahi; sirf wahi models jinka real mechanism aur build quality field me proven hai.</span>
                </div>
                <div class="flex items-start gap-3 bg-slate-900/80 p-4 rounded-xl border border-slate-700/60">
                  <span class="text-amber-400 font-black text-lg">✓</span>
                  <span><strong class="text-white font-semibold">Original Specifications:</strong> Aam dukandar dwara diye jane wale local aluminum mix wire ya duplicate MCB se bachav.</span>
                </div>
                <div class="flex items-start gap-3 bg-slate-900/80 p-4 rounded-xl border border-slate-700/60">
                  <span class="text-amber-400 font-black text-lg">✓</span>
                  <span><strong class="text-white font-semibold">Direct Sizing Match:</strong> Hamare load calculation articles aur wiring sizing guides ke sath 100% compatible recommendations.</span>
                </div>
                <div class="flex items-start gap-3 bg-slate-900/80 p-4 rounded-xl border border-slate-700/60">
                  <span class="text-amber-400 font-black text-lg">✓</span>
                  <span><strong class="text-white font-semibold">Full Transparency:</strong> Sahi IS Code aur CM/L standards ka khulasa taaki aap official BIS Care App se authenticity check kar sakein.</span>
                </div>
              </div>
            </div>
          </div>
        </div>

      </section>

      <!-- Transparency Disclosure -->
      <footer class="mt-16 p-6 sm:p-8 rounded-2xl bg-slate-800/80 border border-slate-700/80 text-center shadow-lg">
        <p class="text-sm sm:text-base text-slate-300 max-w-3xl mx-auto leading-relaxed">
          <strong class="text-amber-400 font-bold">Transparency Disclosure:</strong> Bijli Gyaan par hum genuine field standards ko promote karte hain. Jab aap diye gaye links se verified products khareedte hain, toh platform ko bina aapke koi extra cost lage chhota sa referral commission mil sakta hai, jo is educational website aur free tools ko chalane me madad karta hai.
        </p>
      </footer>

    </div>
  </main>
</Layout>

<!-- Client-side Category Filtering Logic -->
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.product-card');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      // Toggle button active classes
      buttons.forEach((b) => {
        b.classList.remove('bg-amber-400', 'text-slate-950');
        b.classList.add('bg-slate-800', 'text-slate-300');
      });
      btn.classList.remove('bg-slate-800', 'text-slate-300');
      btn.classList.add('bg-amber-400', 'text-slate-950');

      const filterValue = btn.getAttribute('data-filter');

      // Filter product cards smoothly
      cards.forEach((card) => {
        const cardCategory = card.getAttribute('data-category');
        if (filterValue === 'all' || filterValue === cardCategory) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>