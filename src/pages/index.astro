---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SolarFloatWidget from '../components/SolarFloatWidget.astro';
import WorkSlider from '../components/WorkSlider.astro';

const botUrl = "https://officialpramod91-tech.github.io/solar-sathi-ai/";

// Fetch all verified real articles and sort by latest pubDate
const allArticles = await getCollection('articles');
const latestArticles = allArticles
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 4); // Homepage par top 4 latest guides

const categories = [
  {
    title: 'Home Electrical Guide',
    desc: 'House wiring, single/three phase connection, load calculation aur distribution ki practical guidelines.',
    icon: '🏠',
    href: '/category/home-electrical-guide'
  },
  {
    title: 'Electrical Safety',
    desc: 'MCB vs RCCB selection, electric shock protection, earthing standards aur home safety tips.',
    icon: '🛡️',
    href: '/category/electrical-safety'
  },
  {
    title: 'Solar & Smart Energy',
    desc: 'Solar panel sizing, PM Surya Ghar subsidy calculation, net metering aur inverter guides.',
    icon: '☀️',
    href: '/category/solar-smart-energy'
  },
  {
    title: 'Electricity Bill Guide',
    desc: 'Unit consumption calculation, meter reading rules aur power bill kam karne ke verified methods.',
    icon: '💡',
    href: '/category/electricity-bill-guide'
  },
  {
    title: 'Home Appliances Guide',
    desc: 'AC, geyser, cooler, stabilizer aur heavy load appliances ka power consumption aur safety standards.',
    icon: '🔌',
    href: '/category/home-appliances-guide'
  }
];
---

<Layout>
  <!-- SEO Hero Section -->
  <header class="bg-gradient-to-b from-slate-900 via-slate-900 to-slate-950 text-white pt-14 pb-12 px-4 border-b border-slate-800/80">
    <div class="max-w-4xl mx-auto text-center space-y-5">
      <div class="inline-flex items-center gap-2 bg-amber-500/10 text-amber-400 border border-amber-500/30 text-xs font-semibold px-3 py-1 rounded-full">
        <span>⚡</span> Practical Field Knowledge Base
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white leading-tight">
        Bijli Gyaan <span class="text-amber-400">⚡</span> Home Electrical Guide
      </h1>
      
      <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        Safe Ghar. Smart Wiring. Practical Electrical Knowledge.
      </p>

      <div class="pt-2 flex flex-wrap justify-center gap-3">
        <a 
          href="#latest-articles" 
          class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-7 py-3 rounded-xl text-sm transition-all shadow-lg hover:shadow-emerald-600/20"
        >
          Explore Latest Guides ↓
        </a>
        <a 
          href="https://youtube.com/@BijliGyaanOfficial" 
          target="_blank"
          rel="noopener noreferrer"
          class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 font-semibold px-5 py-3 rounded-xl text-sm transition-all flex items-center gap-2"
        >
          <span class="text-rose-500">▶</span> YouTube Channel
        </a>
      </div>

      <!-- Trust Badges (E-E-A-T) -->
      <div class="pt-6 flex flex-wrap justify-center items-center gap-5 text-xs sm:text-sm text-slate-400">
        <div class="flex items-center gap-2">
          <span>👨‍🔧</span>
          <span class="text-slate-200">10+ Saal Ka Field Experience</span>
        </div>
        <span class="text-slate-700 hidden sm:inline">•</span>
        <div class="flex items-center gap-2">
          <span>📑</span>
          <span class="text-slate-200">Verified Practical Guides</span>
        </div>
        <span class="text-slate-700 hidden sm:inline">•</span>
        <div class="flex items-center gap-2">
          <span>🇮🇳</span>
          <span class="font-semibold text-amber-400">100% Hindi Content</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Field Proof Auto Slider -->
  <WorkSlider />

  <!-- Side-by-Side Dual Power Tools Hub (Desktop 2-Col Grid) -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center mb-8">
      <h2 class="text-xl sm:text-2xl font-black text-slate-900 flex items-center justify-center gap-2">
        <span class="text-amber-500">⚡</span> Free Interactive Tools
      </h2>
      <p class="text-xs text-slate-500 mt-1">Ghar ka kharcha calculate karein aur bill zero karne ka plan banayein</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">
      
      <!-- CARD 1: Free Electricity Bill Calculator -->
      <div class="bg-gradient-to-br from-slate-950 via-slate-900 to-cyan-950/60 rounded-3xl p-6 sm:p-7 border-2 border-cyan-400/40 shadow-xl text-white relative overflow-hidden flex flex-col justify-between">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 bg-cyan-500/20 text-cyan-300 text-xs font-bold px-3 py-1 rounded-full border border-cyan-400/30">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
            Smart Appliance Calculator
          </div>
          <h3 class="text-xl sm:text-2xl font-extrabold text-white">
            Ghar Ka Bijli Bill <span class="text-cyan-400">Turant Calculate</span> Karein
          </h3>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
            BLDC Fan, Inverter AC, Geyser, Induction aur Motor ke actual running wattage ke hisab se exact units aur slab bill jaanein.
          </p>
        </div>

        <div class="pt-6">
          <a 
            href="/calculator" 
            class="w-full inline-flex items-center justify-center gap-2 bg-gradient-to-r from-cyan-500 to-cyan-600 hover:from-cyan-400 hover:to-cyan-500 text-slate-950 font-black px-6 py-3.5 rounded-xl text-sm shadow-lg transition-transform active:scale-95 group"
          >
            <span>⚡</span>
            <span>Calculate Bill Now</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
          <p class="text-[11px] text-slate-400 mt-2 text-center">All Modern Appliances Supported • 100% Free</p>
        </div>
      </div>

      <!-- CARD 2: Solar Sathi AI Lead Hook with Chat Preview UI -->
      <div class="bg-gradient-to-br from-slate-950 via-slate-900 to-amber-950/60 rounded-3xl p-6 sm:p-7 border-2 border-amber-400/50 shadow-xl text-white relative overflow-hidden flex flex-col justify-between">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 bg-amber-500/20 text-amber-300 text-xs font-bold px-3 py-1 rounded-full border border-amber-400/30">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            PM Surya Ghar AI Assistant
          </div>
          <h3 class="text-xl sm:text-2xl font-extrabold text-white">
            Bijli Bill Zero Karna Hai? <span class="text-amber-400">Solar Sathi AI</span>
          </h3>
          
          <div class="bg-slate-950/90 rounded-xl p-3 border border-slate-800 space-y-2 text-xs">
            <div class="flex items-start gap-2">
              <span class="w-5 h-5 rounded-full bg-amber-400 text-slate-950 text-[10px] font-black flex items-center justify-center shrink-0">AI</span>
              <div class="bg-slate-800 text-slate-200 px-3 py-1.5 rounded-lg rounded-tl-none text-[11px]">
                Namaste! Mahine ka bijli bill kitna aata hai? Main subsidy nikal kar deta hoon.
              </div>
            </div>
            <div class="flex items-center justify-end gap-1.5 text-[10px] text-amber-400 font-semibold pr-1">
              <span>⚡ ₹78,000 tak sarkari subsidy</span>
              <span>•</span>
              <span>30 Sec Result</span>
            </div>
          </div>
        </div>

        <div class="pt-6">
          <a 
            href={botUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black px-6 py-3.5 rounded-xl text-sm shadow-lg transition-transform active:scale-95 group"
          >
            <span>☀️</span>
            <span>Check Subsidy & System</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </a>
          <p class="text-[11px] text-slate-400 mt-2 text-center">Instant AI Analysis • 100% Free Subsidy Report</p>
        </div>
      </div>

    </div>
  </section>

  <!-- LATEST ARTICLES GRID (100% Dynamic & Real Indexed Content) -->
  <section id="latest-articles" class="max-w-6xl mx-auto px-4 py-10">
    <div class="flex items-center justify-between mb-8 border-b border-slate-200 pb-4">
      <div>
        <h2 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
          <span>📑</span> Latest Practical Guides
        </h2>
        <p class="text-xs text-slate-500 mt-1">Real field issues aur cost-saving technical articles</p>
      </div>
      <a href="#categories-section" class="text-xs sm:text-sm font-semibold text-emerald-700 hover:text-emerald-800">
        Browse by Category →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {latestArticles.map((article) => (
        <article class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md hover:border-amber-400 transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full border bg-amber-500/10 text-amber-700 border-amber-500/20 uppercase">
                {article.data.category?.replace(/-/g, ' ')}
              </span>
              <span class="text-[11px] text-slate-400 font-medium">
                {article.data.readTime || '6 min read'}
              </span>
            </div>

            <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover:text-amber-600 transition-colors leading-snug">
              <a href={`/articles/${article.id}`}>
                {article.data.title}
              </a>
            </h3>

            <p class="text-xs sm:text-sm text-slate-600 mt-2.5 leading-relaxed line-clamp-3">
              {article.data.description}
            </p>
          </div>

          <div class="pt-5 mt-4 border-t border-slate-100 flex items-center justify-between text-xs">
            <a 
              href={`/articles/${article.id}`} 
              class="font-bold text-emerald-700 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1"
            >
              Poora Guide Padhein <span>→</span>
            </a>
            <span class="text-slate-400 text-[11px]">Field Verified ✓</span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Categories Section -->
  <section id="categories-section" class="max-w-6xl mx-auto px-4 py-12">
    <div class="flex items-center justify-between mb-8 border-b border-slate-200 pb-4">
      <div>
        <h2 class="text-2xl font-bold text-slate-900 flex items-center gap-2">
          <span class="text-amber-500">⚡</span> Explore Categories
        </h2>
        <p class="text-xs text-slate-500 mt-1">Verified technical guides structured for easy learning</p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {categories.map((cat) => (
        <a 
          href={cat.href} 
          class="bg-white p-6 rounded-xl border border-slate-200/90 shadow-sm hover:shadow-md hover:border-amber-400 transition-all group flex flex-col justify-between"
        >
          <div>
            <div class="text-3xl mb-3 group-hover:scale-110 transition-transform w-fit">{cat.icon}</div>
            <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-amber-600 transition-colors">
              {cat.title}
            </h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
              {cat.desc}
            </p>
          </div>
          <span class="text-xs font-semibold text-emerald-700 mt-4 inline-flex items-center gap-1">
            Padhein <span>→</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Author Authority Block (E-E-A-T) -->
  <section class="max-w-4xl mx-auto px-4 pb-16">
    <article class="bg-slate-900 text-slate-200 rounded-2xl p-6 sm:p-8 border border-slate-800 shadow-md">
      <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5">
        <div class="w-16 h-16 rounded-full bg-slate-800 border-2 border-amber-400 flex items-center justify-center text-3xl shrink-0">
          👨‍🔧
        </div>
        <div class="space-y-3 text-center sm:text-left">
          <p class="text-xs font-bold uppercase tracking-wider text-amber-400">Authentic Field Knowledge</p>
          <p class="text-sm sm:text-base leading-relaxed text-slate-300">
            Yeh platform real field experience par based hai — sirf kitaabi gyaan nahi. Isme aapko wiring, safety, solar, aur electricity bill se juda practical, sach mein kaam aane wala content milega.
          </p>
          <div class="pt-1">
            <span class="font-bold text-white text-sm">Er. Pramod Kumar</span>
            <span class="text-xs text-slate-400 block sm:inline sm:ml-2">
              (10+ saal ka industrial electrical maintenance experience)
            </span>
          </div>
        </div>
      </div>
    </article>
  </section>
  <SolarFloatWidget />
</Layout>