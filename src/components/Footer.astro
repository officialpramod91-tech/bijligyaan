---
const currentYear = new Date().getFullYear();
const botUrl = "https://officialpramod91-tech.github.io/solar-sathi-ai/";

const topCategories = [
  { name: 'Home Electrical Guide', href: '/category/home-electrical-guide' },
  { name: 'Electrical Safety & MCB', href: '/category/electrical-safety' },
  { name: 'Solar & Smart Energy', href: '/category/solar-smart-energy' },
  { name: 'Electricity Bill Guide', href: '/category/electricity-bill-guide' },
  { name: 'Home Appliances Guide', href: '/category/home-appliances-guide' },
];

const tools = [
  { name: 'Electricity Bill Calculator', href: '/calculator' },
  { name: 'Solar Sathi AI Assistant', href: botUrl, external: true },
];

const policies = [
  { name: 'About Us', href: '/about' },
  { name: 'Contact Us', href: '/contact' },
  { name: 'Privacy Policy', href: '/privacy-policy' },
  { name: 'Disclaimer', href: '/disclaimer' },
  { name: 'XML Sitemap', href: '/sitemap-index.xml' },
];
---

<footer class="bg-slate-950 text-slate-300 pt-14 pb-8 border-t border-slate-800 text-sm">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8 pb-12 border-b border-slate-800/80">
      
      <!-- Col 1: Brand & Author Authority -->
      <div class="space-y-4">
        <a href="/" class="flex items-center gap-2 text-xl font-extrabold text-amber-400">
          ⚡ <span>Bijli Gyaan</span>
        </a>
        <p class="text-xs text-slate-400 leading-relaxed">
          Safe Ghar. Smart Wiring. Practical Electrical Knowledge. Real field experience par based 100% Hindi electrical guide.
        </p>
        <div class="pt-1 border-l-2 border-amber-400 pl-2">
          <p class="text-xs font-semibold text-white">Er. Pramod Kumar</p>
          <p class="text-[11px] text-slate-400">10+ Saal Ka Industrial & Field Experience</p>
        </div>

        <!-- Social Media Links (E-E-A-T & Community) -->
        <div class="pt-2 flex items-center gap-3">
          <a 
            href="https://youtube.com/@BijliGyaanOfficial" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-8 h-8 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-rose-500 hover:border-rose-500 hover:bg-rose-500/10 transition-all text-sm"
            aria-label="YouTube Channel"
            title="Subscribe on YouTube"
          >
            ▶
          </a>
          <a 
            href="https://instagram.com/bijligyaan.in" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-8 h-8 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-pink-400 hover:border-pink-500 hover:bg-pink-500/10 transition-all text-sm"
            aria-label="Instagram Profile"
            title="Follow on Instagram"
          >
            📸
          </a>
          <a 
            href="https://wa.me/918173031237?text=Namaste%20Bijli%20Gyaan" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-8 h-8 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-emerald-400 hover:border-emerald-500 hover:bg-emerald-500/10 transition-all text-sm"
            aria-label="WhatsApp Support"
            title="Chat on WhatsApp"
          >
            💬
          </a>
        </div>
      </div>

      <!-- Col 2: Core Learning Guides -->
      <div>
        <h4 class="text-white font-semibold text-xs tracking-wider uppercase mb-4 border-l-2 border-amber-400 pl-2">
          Important Guides
        </h4>
        <ul class="space-y-2.5 text-xs text-slate-400">
          {topCategories.map((item) => (
            <li>
              <a href={item.href} class="hover:text-amber-400 transition-colors">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Real Tools & Lead Engines -->
      <div>
        <h4 class="text-white font-semibold text-xs tracking-wider uppercase mb-4 border-l-2 border-amber-400 pl-2">
          Tools & Calculators
        </h4>
        <ul class="space-y-2.5 text-xs text-slate-400">
          {tools.map((item) => (
            <li>
              <a 
                href={item.href} 
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
                class="hover:text-amber-400 transition-colors flex items-center gap-1.5"
              >
                <span class="text-amber-400">⚡</span>
                <span class="text-slate-300 font-medium">{item.name}</span>
              </a>
            </li>
          ))}
        </ul>

        <!-- Fully Clickable Solar Sathi Lead Card -->
        <a 
          href={botUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 p-3 rounded-xl bg-slate-900/90 hover:bg-slate-900 border border-amber-500/40 hover:border-amber-400 text-[11px] text-slate-400 block transition-all group shadow-sm hover:shadow-amber-500/10"
        >
          <div class="flex items-center justify-between text-amber-300 font-semibold mb-1">
            <span class="flex items-center gap-1.5">
              <span>☀️</span> Solar Help Chahiye?
            </span>
            <span class="text-xs group-hover:translate-x-1 transition-transform text-amber-400">→</span>
          </div>
          <p class="leading-relaxed text-slate-300 group-hover:text-white transition-colors">
            Solar Sathi AI se 30 seconds me exact subsidy aur rooftop capacity jaanein.
          </p>
        </a>
      </div>

      <!-- Col 4: Mandatory Legal Pages -->
      <div>
        <h4 class="text-white font-semibold text-xs tracking-wider uppercase mb-4 border-l-2 border-amber-400 pl-2">
          Legal & Policies
        </h4>
        <ul class="space-y-2.5 text-xs text-slate-400">
          {policies.map((item) => (
            <li>
              <a href={item.href} class="hover:text-amber-400 transition-colors">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

    </div>

    <!-- Safety & Disclosure Disclaimers -->
    <div class="py-6 border-b border-slate-900 text-[11px] text-slate-500 leading-relaxed space-y-2">
      <p>
        <strong class="text-slate-400">Electrical Safety Disclaimer:</strong> Bijli Gyaan par di gayi jankari sirf awareness aur practical education ke liye hai. Kisi bhi appliance ya main line par bina security tools ke kaam na karein. Critical wiring ke liye hamesha licensed professional ki madad lein.
      </p>
      <p>
        <strong class="text-slate-400">Affiliate Disclosure:</strong> Is blog par diye gaye kuch product links affiliate ho sakte hain jisse chhota commission mil sakta hai, bina aapki kisi extra cost ke.
      </p>
    </div>

    <!-- Clean Bottom Copyright Bar -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>
        Copyright © {currentYear} Bijli Gyaan. All rights reserved.
      </p>
      <p class="text-[11px] text-slate-500">
        Empowering Homes With Safe Electrical Practices
      </p>
    </div>
  </div>
</footer>